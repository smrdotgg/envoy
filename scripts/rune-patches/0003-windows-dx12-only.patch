index 094a381..a7a1a08 100644
--- a/vendor/rune/crates/rune/Cargo.toml
+++ b/vendor/rune/crates/rune/Cargo.toml
@@ -171,8 +171,17 @@ zbus = { version = "5.19", default-features = false, features = ["tokio"], optio
 tokio = { version = "1", features = ["rt", "net", "time", "sync", "macros"], optional = true }
 futures-util = { version = "0.3", optional = true }
 
-[target.'cfg(all(not(target_vendor = "apple"), not(target_arch = "wasm32")))'.dependencies]
-wgpu = { version = "30", default-features = false, features = ["vulkan", "dx12"] }
+[target.'cfg(all(not(target_vendor = "apple"), not(target_arch = "wasm32"), not(target_os = "windows")))'.dependencies]
+wgpu = { version = "30", default-features = false, features = ["vulkan"] }
+
+# Windows draws with DX12 (`Gpu::wgpu_instance`), which always has an adapter there: DXGI lists
+# WARP, the software rasterizer, on every Windows that runs Rust's MSVC target (10 and later),
+# with or without a GPU. Vulkan was only the fallback for a DX12 that listed none, so it isn't
+# built: no Vulkan backend, SPIR-V writer or loader in Windows binaries (about 1.2 MB).
+[target.'cfg(target_os = "windows")'.dependencies.wgpu]
+version = "30"
+default-features = false
+features = ["dx12"]
 
 [lints]
 workspace = true
diff --git a/vendor/rune/crates/rune/src/gpu/pick.rs b/vendor/rune/crates/rune/src/gpu/pick.rs
index caa9de5..040fc0e 100644
--- a/vendor/rune/crates/rune/src/gpu/pick.rs
+++ b/vendor/rune/crates/rune/src/gpu/pick.rs
@@ -123,7 +123,18 @@ fn request(instance: &wgpu::Instance, surface: Option<&wgpu::Surface<'_>>, power
         compatible_surface: surface,
         apply_limit_buckets: false,
     }))
-    .map_err(|error| format!("no GPU adapter: {error}"))
+    .map_err(|error| no_adapter(&error))
+}
+
+#[cfg(not(target_os = "windows"))]
+fn no_adapter(error: &dyn std::fmt::Display) -> String { format!("no GPU adapter: {error}") }
+
+/// Windows draws with DX12 alone (`Gpu::wgpu_instance`), whose adapter list always holds WARP
+/// when Direct3D 12 works at all: none means it didn't start.
+#[cfg(target_os = "windows")]
+fn no_adapter(error: &dyn std::fmt::Display) -> String {
+    format!("Direct3D 12 didn't start: no DX12 adapter, not even WARP, Windows' software renderer ({error}). \
+        Update or reinstall the graphics driver; if that doesn't help, repair Windows' graphics components (d3d12.dll, dxgi.dll)")
 }
 
